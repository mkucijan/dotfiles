# ~/.config/mise/config.toml — managed by chezmoi
[settings]
experimental = true
lockfile = true
# python envs via uv; rust (dev) via mise rust backend (rustup underneath)
disable_backends = ["asdf"]

[tools]
# ---- base: shell + core CLI (also on the Pi / Termux) ----
chezmoi  = "latest"
starship = "latest"
fzf      = "latest"
ripgrep  = "latest"
fd       = "latest"
bat      = "latest"
eza      = { version = "latest", os = ["linux"] }   # no macOS release binary
zoxide   = "latest"
delta    = "latest"
lazygit  = "latest"
jq       = "latest"
dust     = "latest"
{{- if not .termux }}
neovim   = "latest"
gh       = "latest"
atuin    = "latest"
btop     = { version = "latest", os = ["linux"] }
bitwarden = "latest"   # bw CLI (personal vault only; not used by the secrets flow)
"github:bitwarden/sdk-sm" = { version = "latest", version_prefix = "bws-v", bin = "bws" }   # Secrets Manager CLI
{{- else }}
# Termux: glibc bw binary does not run on bionic; use the npm build on pkg nodejs
"npm:@bitwarden/cli" = "latest"
# bws has no android build: `cargo install bws --locked` (pkg install rust) if needed
{{- end }}
{{- if .profile.dev }}

# ---- dev: toolchains, LSPs, formatters (nvim enables LSPs only if the binary exists) ----
node       = "lts"
python     = "latest"
uv         = "latest"
pnpm       = "latest"
go         = "latest"
rust       = { version = "stable", components = "rust-analyzer,rustfmt,clippy" }
tree-sitter = "latest"
"aqua:LuaLS/lua-language-server" = "latest"
stylua     = "latest"
ruff       = "latest"
shellcheck = "latest"
shfmt      = "latest"
"npm:pyright" = "latest"
"npm:typescript" = "latest"
"npm:typescript-language-server" = "latest"
"npm:bash-language-server" = "latest"
xh         = "latest"
tealdeer   = "latest"
{{- end }}
{{- if .profile.agent }}

# ---- agent: AI tool helpers (the AI CLIs themselves: .chezmoidata/agents.toml) ----
"github:vectorize-io/hindsight" = { version = "latest", bin = "hindsight" }
{{- end }}

[env]
EDITOR = "nvim"

[tasks.up]
description = "Update dotfiles, tools and nvim plugins"
run = ["chezmoi update --apply", "mise upgrade --bump=false", "nvim --headless -c 'if exists(\":Lazy\") | exe \"Lazy! sync\" | endif' +qa"]

[tasks.doctor]
description = "Health check of the terminal setup"
run = ["mise doctor", "chezmoi doctor", "zsh -i -c 'zmodload zsh/zprof; exit' && hyperfine -N --warmup 2 'zsh -i -c exit' 2>/dev/null || time zsh -i -c exit"]

[tasks.secrets]
description = "Pull secrets from Bitwarden Secrets Manager (bws) per .chezmoidata/secrets.toml"
run = ["chezmoi apply ~/.local/bin/secrets-sync", "secrets-sync", "chezmoi apply ~/.grok/config.toml"]
