# ~/.config/mise/config.toml — managed by chezmoi
[settings]
experimental = true
lockfile = true
# rust stays on rustup; python envs via uv
disable_backends = ["asdf"]

[tools]
chezmoi  = "latest"
starship = "latest"
fzf      = "latest"
ripgrep  = "latest"
fd       = "latest"
bat      = "latest"
eza      = "latest"
zoxide   = "latest"
delta    = "latest"
lazygit  = "latest"
jq       = "latest"
{{- if not .termux }}
neovim   = "0.12"
gh       = "latest"
bitwarden = "2026.10.0"   # bw CLI, native linux/macos x64+arm64
"github:vectorize-io/hindsight" = { version = "1.1.0", bin = "hindsight" }
atuin    = "latest"
uv       = "latest"
{{- else }}
# Termux: glibc bw binary does not run on bionic; use the npm build on pkg nodejs
"npm:@bitwarden/cli" = "2026.10.0"
{{- end }}
{{- if eq .role "desktop" }}
node     = "lts"
python   = "3.13"
pnpm     = "latest"
btop     = { version = "latest", os = ["linux"] }
dust     = "latest"
xh       = "latest"
tealdeer = "latest"
{{- end }}

[env]
EDITOR = "nvim"

[tasks.up]
description = "Update dotfiles, tools and nvim plugins"
run = ["chezmoi update --apply", "mise upgrade --bump=false", "nvim --headless '+Lazy! sync' +qa"]

[tasks.doctor]
description = "Health check of the terminal setup"
run = ["mise doctor", "chezmoi doctor", "zsh -i -c 'zmodload zsh/zprof; exit' && hyperfine -N --warmup 2 'zsh -i -c exit' 2>/dev/null || time zsh -i -c exit"]

[tasks.secrets]
description = "Apply secret-backed files from Bitwarden (needs BW_SESSION; run `bwu` first)"
run = "test -n \"$BW_SESSION\" || { echo 'locked: run bwu (export BW_SESSION=$(bw unlock --raw))'; exit 1; }; bw sync -q; chezmoi apply ~/.config/hindsight/api_key ~/.grok/config.toml"
