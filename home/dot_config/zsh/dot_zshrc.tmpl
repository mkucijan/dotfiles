# ~/.config/zsh/.zshrc — managed by chezmoi. Machine-only bits: $ZDOTDIR/local.zsh
has() { (( $+commands[$1] )) }
ZCACHE="$XDG_CACHE_HOME/zsh"; [[ -d $ZCACHE ]] || mkdir -p "$ZCACHE"
ZPLUG="$XDG_DATA_HOME/zsh/plugins"

# history (keep existing file if present)
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=10000000 SAVEHIST=10000000
setopt INC_APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS

# cache output of `cmd init`-style generators; regenerate when the binary changes
_cache_eval() { # name cmd...
  local f="$ZCACHE/$1.zsh" bin="${commands[$2]}"; shift
  [[ -n $bin ]] || return 0
  [[ -s $f && $f -nt $bin ]] || "$@" >| "$f" 2>/dev/null
  source "$f"
}

# tools: mise first so its shims/PATH feed the rest
if has mise; then _cache_eval mise mise activate zsh; fi

# completions: one compinit, cached dump, generated completions in $ZCACHE/completions
fpath=("$ZCACHE/completions" "$HOME/.grok/completions/zsh" $fpath)
[[ -d $ZCACHE/completions ]] || mkdir -p "$ZCACHE/completions"
for c in kubectl skaffold; do
  has $c && [[ ! -s $ZCACHE/completions/_$c || $ZCACHE/completions/_$c -ot ${commands[$c]} ]] && $c completion zsh >| "$ZCACHE/completions/_$c" 2>/dev/null
done
autoload -Uz compinit
() { setopt local_options extended_glob
  local d=$ZCACHE/zcompdump
  if [[ -f $d && -z $d(#qN.mh+24) ]]; then compinit -C -d $d; else compinit -d $d; { zcompile $d } &!; fi }
zmodload zsh/complist
zstyle ':completion:*' menu select
_comp_options+=(globdots)

# vi mode + cursor shape
bindkey -v; export KEYTIMEOUT=1
zle-keymap-select() { [[ $KEYMAP == vicmd ]] && echo -ne '\e[1 q' || echo -ne '\e[5 q' }
zle-line-init() { echo -ne '\e[5 q' }
zle -N zle-keymap-select; zle -N zle-line-init
autoload -Uz edit-command-line; zle -N edit-command-line; bindkey '^z' edit-command-line
bindkey -M menuselect 'h' vi-backward-char 'k' vi-up-line-or-history 'l' vi-forward-char 'j' vi-down-line-or-history
bindkey -v '^?' backward-delete-char

# aliases (guarded)
has nvim && alias vim=nvim vimdiff='nvim -d' v='nvim -p'
has eza  && alias ls='eza --group-directories-first' ll='eza -l --git' la='eza -la --git'
has bat  && alias cat='bat --paging=never --style=plain'
# clipboard: OSC52 works everywhere (tmux/ssh/mosh); prefer native when available
if [[ $OSTYPE == darwin* ]]; then :
elif has wl-copy; then alias pbcopy=wl-copy pbpaste=wl-paste
elif has xclip && [[ -n $DISPLAY ]]; then alias pbcopy='xclip -sel clip' pbpaste='xclip -sel clip -o'
else pbcopy() { printf '\e]52;c;%s\a' "$(base64 | tr -d '\n')" }; fi

# fzf / fd
FD_OPTIONS="--follow --exclude .git --exclude node_modules"
export FZF_DEFAULT_OPTS="--height 50% --layout=reverse --border --multi --inline-info --bind=ctrl-d:half-page-down,ctrl-u:half-page-up"
if has fd; then
  export FZF_DEFAULT_COMMAND="fd --type f --type l $FD_OPTIONS"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND" FZF_ALT_C_COMMAND="fd --type d $FD_OPTIONS"
fi
has fzf      && _cache_eval fzf fzf --zsh
has zoxide   && _cache_eval zoxide zoxide init zsh
has atuin    && _cache_eval atuin atuin init zsh
has starship && _cache_eval starship starship init zsh

# plugins (cloned by chezmoi externals)
[[ -r $ZPLUG/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source $ZPLUG/zsh-autosuggestions/zsh-autosuggestions.zsh && bindkey '^E' autosuggest-accept
[[ -r $ZPLUG/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source $ZPLUG/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Bitwarden personal vault (bw): unlock once per shell. Machine secrets use bws (mise run secrets).
bwu() { export BW_SESSION="$(bw unlock --raw)" && bw sync -q && echo "bitwarden unlocked" }
bwl() { bw lock >/dev/null; unset BW_SESSION }

# installers that insist on editing rc files: put their lines here (untracked)
[[ -r $ZDOTDIR/local.zsh ]] && source $ZDOTDIR/local.zsh
unfunction has
