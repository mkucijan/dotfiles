typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.cargo/bin" $path)
export EDITOR=nvim VISUAL=nvim PAGER="less" BAT_PAGER="less -R"
{{- if eq .chezmoi.hostname "arch" }}
# arch-only toolchains
[[ -d $HOME/.ghcup/bin ]]   && path+=("$HOME/.ghcup/bin")
[[ -d $HOME/.modular/bin ]] && path+=("$HOME/.modular/bin")
[[ -d $HOME/.pixi/bin ]]    && path=("$HOME/.pixi/bin" $path)
[[ -d /opt/android-studio/jbr ]] && export JAVA_HOME=/opt/android-studio/jbr
[[ -d $HOME/Android/Sdk ]] && export ANDROID_HOME="$HOME/Android/Sdk"
{{- end }}

# Secrets from bws (secrets-sync): 0600, untracked
[[ -r $XDG_CONFIG_HOME/secrets/env ]] && source $XDG_CONFIG_HOME/secrets/env

{{- if .profile.agent }}
# agent profile: AI CLIs on PATH (.chezmoidata/agents.toml)
{{- range .agents }}{{ if .path }}
path=("{{ .path | replace "~" "$HOME" }}" $path)
{{- end }}{{ end }}

# Hindsight (memory): cloud profile + default bank; API key from an untracked 0600 file
export HINDSIGHT_PROFILE=cloud HINDSIGHT_BANK=personal
[[ -r $XDG_CONFIG_HOME/hindsight/api_key ]] && export HINDSIGHT_API_KEY="$(<$XDG_CONFIG_HOME/hindsight/api_key)"
{{- end }}
