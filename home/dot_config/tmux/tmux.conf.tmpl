# ~/.config/tmux/tmux.conf — managed by chezmoi (tmux >= 3.2)
set -g default-terminal "tmux-256color"
set -as terminal-features ",alacritty*:RGB,xterm-256color:RGB"
set -g escape-time 10
set -g history-limit 50000
set -g focus-events on
set -g display-time 2000
set -g status-interval 5
set -g status-position top
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g mouse on
set -g allow-rename off
setw -g aggressive-resize on

# clipboard via OSC 52: works locally, over ssh/mosh, Termux, macOS
set -g set-clipboard on
set -g allow-passthrough on

# prefix: backtick (as before)
unbind C-b
set -g prefix `
bind ` send-prefix

# splits/windows keep cwd
unbind '"'; unbind %
bind '"' split-window -c "#{pane_current_path}"
bind v split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5
bind r source-file ~/.config/tmux/tmux.conf \; display "reloaded"

# vi copy mode (native regex search replaces copycat)
setw -g mode-keys vi
bind m copy-mode
bind / copy-mode \; send-key ?
unbind p; bind p paste-buffer
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi C-v send -X rectangle-toggle
bind -T copy-mode-vi y send -X copy-selection-and-cancel
{{- if .profile.ui }}
bind -T copy-mode-vi o send -X copy-pipe-and-cancel "{{ if eq .chezmoi.os "darwin" }}xargs open{{ else }}xargs -r xdg-open{{ end }}"
{{- end }}

# catppuccin mocha (pinned external, no tpm). basic window style + block
# separators: no Nerd Font / powerline required. Module icons cleared so
# Termux/Pi without a patched font don't show tofu; text still reads fine.
set -g visual-activity off
set -g bell-action none
set -g @catppuccin_flavor "mocha"
set -g @catppuccin_window_status_style "basic"
set -g @catppuccin_status_left_separator "█"
set -g @catppuccin_status_right_separator "█"
set -g @catppuccin_status_connect_separator "yes"
set -g @catppuccin_session_icon ""
set -g @catppuccin_host_icon ""
set -g @catppuccin_date_time_icon ""
set -g @catppuccin_date_time_text " %H:%M"
run-shell "~/.local/share/tmux/plugins/catppuccin/catppuccin.tmux"
set -g status-left-length 100
set -g status-right-length 100
set -g status-left "#{E:@catppuccin_status_session}"
set -g status-right "#{E:@catppuccin_status_host}"
set -ag status-right "#{E:@catppuccin_status_date_time}"

# plugins: pinned git checkouts from chezmoi externals
set -g @continuum-restore 'on'
set -g @resurrect-strategy-nvim 'session'
run-shell -b "~/.local/share/tmux/plugins/vim-tmux-navigator/vim-tmux-navigator.tmux"
run-shell -b "~/.local/share/tmux/plugins/tmux-resurrect/resurrect.tmux"
run-shell -b "~/.local/share/tmux/plugins/tmux-continuum/continuum.tmux"

if-shell "test -f ~/.config/tmux/local.conf" "source-file ~/.config/tmux/local.conf"
