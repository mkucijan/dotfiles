{{- if .profile.dev -}}
#!/bin/sh
# dev profile: lazy-lock.json is seed-only (create_), lazy.nvim owns it after install.
# When the repo lock changes, re-seed it and restore plugins to exactly those commits.
# lock: {{ include "dot_config/nvim/create_lazy-lock.json" | sha256sum }}
set -u
cp "{{ .chezmoi.sourceDir }}/dot_config/nvim/create_lazy-lock.json" "$HOME/.config/nvim/lazy-lock.json"
export PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$HOME/.local/bin:$PATH"
command -v nvim >/dev/null 2>&1 || exit 0
nvim --headless '+Lazy! restore' +qa >/dev/null 2>&1 || echo "nvim: Lazy restore failed; run :Lazy restore"
{{- end }}
