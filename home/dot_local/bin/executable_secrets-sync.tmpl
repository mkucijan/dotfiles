#!/usr/bin/env bash
# Generated by chezmoi from .chezmoidata/secrets.toml. Pulls secrets from Bitwarden
# Secrets Manager (bws) into local files. Never prints values, never exits non-zero.
set -uo pipefail
umask 077
note() { printf 'secrets: %s\n' "$*" >&2; }
host={{ .chezmoi.hostname | quote }}
tokfile="${XDG_CONFIG_HOME:-$HOME/.config}/bws/token"
if [[ -z "${BWS_ACCESS_TOKEN:-}" && -r $tokfile ]]; then BWS_ACCESS_TOKEN="$(<"$tokfile")"; fi
[[ -n "${BWS_ACCESS_TOKEN:-}" ]] || { note "no BWS_ACCESS_TOKEN or $tokfile; keeping existing files"; exit 0; }
command -v bws >/dev/null && command -v jq >/dev/null || { note "bws/jq not installed; skipping"; exit 0; }
export BWS_ACCESS_TOKEN
json="$(bws secret list -o json 2>/dev/null)" || { note "bws secret list failed; keeping existing files"; exit 0; }
get() { jq -r --arg k "${1//\{host\}/$host}" 'first(.[] | select(.key == $k) | .value) // empty' <<<"$json"; }
put() { # put PATH MODE  (value on stdin), atomic
  local p="${1/#\~/$HOME}" tmp; mkdir -p "$(dirname "$p")"; tmp="$(mktemp "$p.XXXX")"
  cat >"$tmp" && chmod "$2" "$tmp" && mv -f "$tmp" "$p"; }
n=0
{{- range (.secrets.files | default list) }}
{{- if and (or (not (hasKey . "hosts")) (has $.chezmoi.hostname (get . "hosts"))) (or (not (hasKey . "os")) (has $.chezmoi.os (get . "os"))) }}
v="$(get {{ .key | quote }})"
if [[ -n $v ]]; then printf '%s' "$v" | put {{ .path | quote }} {{ get . "mode" | default "600" | quote }}; n=$((n+1)); else note "missing {{ .key }} (skipped)"; fi
{{- end }}
{{- end }}

envf="${XDG_CONFIG_HOME:-$HOME/.config}/secrets/env"; envbuf="# managed by secrets-sync; do not edit"$'\n'
{{- range (.secrets.env | default list) }}
{{- if and (or (not (hasKey . "hosts")) (has $.chezmoi.hostname (get . "hosts"))) (or (not (hasKey . "os")) (has $.chezmoi.os (get . "os"))) }}
v="$(get {{ .key | quote }})"
if [[ -n $v ]]; then envbuf+="export {{ .var }}=$(printf '%q' "$v")"$'\n'; n=$((n+1)); else note "missing {{ .key }} (skipped)"; fi
{{- end }}
{{- end }}
printf '%s' "$envbuf" | put "$envf" 600

awsblock=""
{{- range (.secrets.aws | default list) }}
{{- if and (or (not (hasKey . "hosts")) (has $.chezmoi.hostname (get . "hosts"))) (or (not (hasKey . "os")) (has $.chezmoi.os (get . "os"))) }}
id="$(get {{ .access_key_id | quote }})"; sk="$(get {{ .secret_access_key | quote }})"
if [[ -n $id && -n $sk ]]; then
  awsblock+="[{{ .profile | replace "{host}" $.chezmoi.hostname }}]"$'\n'"aws_access_key_id = $id"$'\n'"aws_secret_access_key = $sk"$'\n'{{ if hasKey . "region" }}"region = {{ .region }}"$'\n'{{ end }}
  n=$((n+1))
else note "missing {{ .access_key_id | replace "{host}" $.chezmoi.hostname }} / secret (skipped)"; fi
{{- end }}
{{- end }}
if [[ -n $awsblock ]]; then  # replace only our marked block; other profiles (e.g. arch admin) untouched
  cf="$HOME/.aws/credentials"; old=""; [[ -r $cf ]] && old="$(sed '/^# >>> secrets-sync/,/^# <<< secrets-sync/d' "$cf")"
  { [[ -n $old ]] && printf '%s\n\n' "$old"; printf '# >>> secrets-sync\n%s# <<< secrets-sync\n' "$awsblock"; } | put "$cf" 600
fi
note "$n secret(s) synced"
exit 0
