#!/bin/sh
# Pin externals to exact commits. Edit the refs here to update plugins.
# hash: {{ include ".chezmoiexternal.toml" | sha256sum }}
set -eu
P="$HOME/.local/share"
pin() { [ -d "$P/$1/.git" ] || return 0; git -C "$P/$1" fetch -q --depth 50 origin "$2" 2>/dev/null || true; git -C "$P/$1" -c advice.detachedHead=false checkout -q "$2" 2>/dev/null || echo "warn: could not pin $1 to $2"; }
pin tmux/plugins/tmux-resurrect      cff343cf9e81983d3da0c8562b01616f12e8d548
pin tmux/plugins/tmux-continuum      0698e8f4b17d6454c71bf5212895ec055c578da0
pin tmux/plugins/vim-tmux-navigator  e41c431a0c7b7388ae7ba341f01a0d217eb3a432
